{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2024"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "types": [],
    "target": "ES2024"
  },
  "include": [
    "packages/*/src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/test-support/**",
    "tools/*/src/**/*.test.ts",
    // validate-content の public API は Node の filesystem を使うため、その型契約は node 型のある tsconfig.test.json で検査する。
    "tests/validate-content-type-contract.ts"
  ]
}
