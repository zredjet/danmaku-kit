{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2024"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "types": [],
    "target": "ES2024"
  },
  "include": [
    "packages/*/src/**/*.ts",
    "tools/*/src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "packages/*/src/**/*.test.ts",
    "tools/*/src/**/*.test.ts"
  ]
}
